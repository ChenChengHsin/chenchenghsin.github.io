---
interface TimelineEntry {
  date: string;
  title: string;
  link?: string;
}

interface Props {
  heading: string;
  headingId: string;
  entries: TimelineEntry[];
}

const { heading, headingId, entries } = Astro.props;
---

<section class="min-w-0" aria-labelledby={headingId}>
  <h2 id={headingId} class="mb-5 text-xl font-semibold">{heading}</h2>

  <ol class="timeline-list">
    {entries.map((entry) => (
      <li class="timeline-item">
        <span class="timeline-marker" aria-hidden="true"></span>
        <p class="timeline-date">{entry.date}</p>
        <div class="timeline-content">
          {entry.link ? (
            <a href={entry.link}>{entry.title}</a>
          ) : (
            <p>{entry.title}</p>
          )}
        </div>
      </li>
    ))}
  </ol>
</section>

<style>
  .timeline-list {
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .timeline-item {
    position: relative;
    display: grid;
    min-width: 0;
    grid-template-columns: minmax(0, 1fr);
    gap: 0.25rem;
    padding-inline-start: 1.375rem;
    padding-bottom: 1.375rem;
  }

  .timeline-item:last-child {
    padding-bottom: 0;
  }

  .timeline-item:not(:last-child)::after {
    position: absolute;
    top: 0.875rem;
    bottom: -0.625rem;
    inset-inline-start: calc(0.25rem - 0.5px);
    width: 1px;
    background: color-mix(in srgb, var(--c-fg) 18%, transparent);
    content: '';
  }

  .timeline-marker {
    position: absolute;
    top: 0.375rem;
    inset-inline-start: 0;
    width: 0.5rem;
    height: 0.5rem;
    border: 1px solid color-mix(in srgb, var(--c-accent) 75%, transparent);
    border-radius: 9999px;
  }

  .timeline-date,
  .timeline-content,
  .timeline-content p {
    min-width: 0;
    margin: 0;
  }

  .timeline-date {
    color: color-mix(in srgb, var(--c-fg) 45%, transparent);
    font-size: var(--text-sm);
    line-height: 1.5;
  }

  .timeline-content {
    overflow-wrap: anywhere;
    color: color-mix(in srgb, var(--c-fg) 80%, transparent);
    font-weight: 500;
    line-height: 1.5;
  }

  .timeline-content a {
    color: var(--c-accent);
    text-underline-offset: 0.18em;
  }

  .timeline-content a:hover,
  .timeline-content a:focus-visible {
    text-decoration: underline;
  }

  @media (min-width: 40rem) {
    .timeline-item {
      grid-template-columns: minmax(7rem, 9rem) minmax(0, 1fr);
      column-gap: 1.375rem;
      row-gap: 0;
    }
  }
</style>
