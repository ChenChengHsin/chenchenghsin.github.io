---
// 主頁面 - 個人介紹
import { Image } from 'astro:assets';
import BaseLayout from '../layouts/BaseLayout.astro';
import Timeline from '../components/Timeline.astro';
import { site } from '../site.config';
import profileImage from '../assets/profile.png';
import {
  Content as HomeContent,
  frontmatter as homeFrontmatter,
} from '../content/home.md';

interface TimelineEntry {
  date: string;
  title: string;
  link?: string;
}

interface HomeFrontmatter {
  education?: TimelineEntry[];
  experience?: TimelineEntry[];
}

const siteUrl = site.url || 'https://example.com';
const githubUrl = site.author.github
  ? `https://github.com/${site.author.github}`
  : undefined;
const hackmdUrl = site.author.hackmd?.trim() || undefined;
const {
  education = [],
  experience = [],
} = homeFrontmatter as HomeFrontmatter;
---

<BaseLayout
  title="主頁面"
  jsonLd={{
    '@context': 'https://schema.org',
    '@graph': [
      {
        '@type': 'WebSite',
        name: site.name,
        url: siteUrl,
        description: site.description,
      },
      {
        '@type': 'Person',
        name: site.author.name,
        url: siteUrl,
        sameAs: githubUrl ? [githubUrl] : undefined,
      },
    ],
  }}
>
  <div class="max-w-4xl mx-auto px-6 pt-20 pb-14 lg:max-w-[50rem] lg:px-4 lg:pt-16 lg:pb-11">
    <div class="grid items-center gap-10 md:grid-cols-[minmax(0,1fr)_minmax(240px,320px)] md:gap-12 lg:grid-cols-[minmax(0,1fr)_minmax(10rem,13.5rem)] lg:gap-11">
      <div class="min-w-0">
        <p class="text-xs tracking-[0.3em] uppercase text-fg/30 mb-3">PROFILE / 自我介紹</p>
        <div class="home-content">
          <HomeContent />
        </div>

        {(hackmdUrl || site.author.location) && (
          <div class="mt-8 space-y-3 text-fg/60 lg:mt-7">
            {hackmdUrl && (
              <p>HackMD：<a href={hackmdUrl} class="text-accent hover:underline">{site.author.name}</a></p>
            )}
            {site.author.location && <p>📍 {site.author.location}</p>}
          </div>
        )}
      </div>

      <div class="flex justify-center md:translate-x-4 md:-translate-y-16 md:justify-end lg:-translate-x-9 lg:-translate-y-20 xl:-translate-x-4">
        <div
          class="aspect-square w-full max-w-[220px] overflow-hidden rounded-full shadow-lg shadow-black/10
                 sm:max-w-[240px] md:max-w-[214px]"
        >
          <Image
            src={profileImage}
            alt={`${site.author.name} 的個人照片`}
            width={320}
            height={320}
            class="h-full w-full object-cover object-center"
          />
        </div>
      </div>
    </div>

    <div class="mt-20 space-y-14">
      {education.length > 0 && (
        <Timeline
          heading="Education"
          headingId="home-education"
          entries={education}
        />
      )}
      {experience.length > 0 && (
        <Timeline
          heading="Experience"
          headingId="home-experience"
          entries={experience}
        />
      )}
    </div>
  </div>

</BaseLayout>

<style>
  .home-content {
    min-width: 0;
    overflow-wrap: anywhere;
  }

  .home-content :global(h1) {
    margin-bottom: 1.375rem;
    font-size: var(--text-3xl);
    font-weight: 700;
    line-height: 1.2;
  }

  .home-content :global(h2) {
    margin-top: 1.375rem;
    margin-bottom: 0.5rem;
    font-size: var(--text-xl);
    font-weight: 600;
    line-height: 1.3;
  }

  .home-content :global(h3) {
    margin-top: 1rem;
    margin-bottom: 0.375rem;
    font-size: var(--text-lg);
    font-weight: 600;
    line-height: 1.4;
  }

  .home-content :global(p),
  .home-content :global(ul),
  .home-content :global(ol) {
    color: color-mix(in srgb, var(--c-fg) 70%, transparent);
    line-height: 1.65;
  }

  .home-content :global(p + p),
  .home-content :global(p + ul),
  .home-content :global(p + ol) {
    margin-top: 0.75rem;
  }

  .home-content :global(ul),
  .home-content :global(ol) {
    padding-left: 1rem;
  }

  .home-content :global(ul) {
    list-style: disc;
  }

  .home-content :global(ol) {
    list-style: decimal;
  }

  .home-content :global(li + li) {
    margin-top: 0.25rem;
  }

  .home-content :global(a) {
    color: var(--c-accent);
    text-decoration: underline;
    text-underline-offset: 0.18em;
  }

  .home-content :global(a:hover) {
    text-decoration-thickness: 2px;
  }

  .home-content :global(strong) {
    color: var(--c-fg);
    font-weight: 600;
  }

  .home-content :global(em) {
    font-style: italic;
  }
</style>
