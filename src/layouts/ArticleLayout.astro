---
import BaseLayout from './BaseLayout.astro';
import ReadFrostedGlass from '../components/ReadFrostedGlass.astro';
import TableOfContents from '../components/TableOfContents.astro';
import { site } from '../site.config';
import type { MarkdownHeading } from 'astro';
import {
  formatArticleDate,
  toDateTime,
  type ArticleSection,
} from '../utils/articles';

interface Props {
  title: string;
  description: string;
  date: Date;
  updated?: Date;
  tags?: string[];
  section: ArticleSection;
  headings: MarkdownHeading[];
}

const { title, description, date, updated, tags, section, headings } = Astro.props;
const siteUrl = site.url || 'https://example.com';
const tocHeadings = headings.filter((heading) => heading.depth >= 1 && heading.depth <= 3);
const hasTableOfContents = tocHeadings.length > 0;
---

<BaseLayout
  title={title}
  ogType="article"
  ogDescription={description}
  jsonLd={{
    '@context': 'https://schema.org',
    '@type': 'BlogPosting',
    headline: title,
    description,
    datePublished: toDateTime(date),
    dateModified: updated ? toDateTime(updated) : undefined,
    articleSection: section.title,
    author: { '@type': 'Person', name: site.author.name },
    image: new URL(site.ogImage, siteUrl).href,
  }}
>
  <div
    class:list={[
      'mx-auto px-4 pt-16 pb-11',
      hasTableOfContents
        ? 'max-w-[48rem] min-[56rem]:grid min-[56rem]:max-w-[76rem] min-[56rem]:grid-cols-[minmax(0,1fr)_13rem] min-[56rem]:items-start min-[56rem]:gap-6 min-[82rem]:grid-cols-[minmax(0,1fr)_15.5rem] min-[82rem]:gap-12'
        : 'max-w-[55rem]',
    ]}
  >
    <div class="min-w-0">
      <div class="min-[82rem]:-ml-4">
        <ReadFrostedGlass>
          <div class="min-[82rem]:ml-4">
            <div
              class:list={[
                hasTableOfContents &&
                  'min-[56rem]:mx-auto min-[56rem]:max-w-[46rem]',
              ]}
            >
              <a
                href={section.href}
                class="text-sm text-fg/45 transition-colors hover:text-accent"
              >
                ← 回到{section.title}
              </a>

              <header class="mt-4 pb-5 border-b border-fg/10">
                <p class="text-xs tracking-[0.3em] uppercase text-fg/30 mb-2">
                  {section.eyebrow}
                </p>
                <h1 class="text-4xl font-bold text-fg leading-tight">{title}</h1>
                <p class="mt-3 text-lg leading-relaxed text-fg/55">{description}</p>

                <div class="mt-3.5 flex flex-wrap items-center gap-x-3 gap-y-1.5">
                  <time datetime={toDateTime(date)} class="text-sm text-fg/40 font-mono">
                    {formatArticleDate(date)}
                  </time>
                  {updated && (
                    <span class="text-sm text-fg/35">
                      更新於 <time datetime={toDateTime(updated)}>{formatArticleDate(updated)}</time>
                    </span>
                  )}
                  {tags && tags.length > 0 && (
                    <div class="flex flex-wrap gap-1.5">
                      {tags.map((tag) => (
                        <span class="text-sm text-fg/40">#{tag}</span>
                      ))}
                    </div>
                  )}
                </div>
              </header>

              <div
                id="article-content"
                class="mt-5 max-w-none overflow-x-auto prose prose-neutral dark:prose-invert text-lg
                       prose-p:my-3.5 prose-p:leading-relaxed prose-p:text-fg/85
                       prose-headings:scroll-mt-28 prose-headings:text-fg prose-headings:font-semibold
                       prose-headings:mt-7 prose-headings:mb-3.5
                       prose-h1:text-3xl prose-h2:text-2xl prose-h3:text-xl
                       prose-a:text-accent prose-a:no-underline hover:prose-a:underline
                       prose-code:text-base prose-code:font-normal prose-code:text-accent
                       prose-code:bg-fg/5 prose-code:px-1 prose-code:py-0.5 prose-code:rounded
                       prose-pre:my-5 prose-pre:overflow-x-auto prose-pre:rounded-xl
                       prose-pre:border prose-pre:border-fg/10 prose-pre:bg-fg/5
                       prose-img:my-5 prose-img:max-w-full prose-img:rounded-xl
                       prose-li:my-1.5 prose-li:leading-relaxed prose-li:text-fg/85
                       prose-blockquote:rounded-r-lg prose-blockquote:border-l-accent prose-blockquote:bg-fg/3
                       prose-hr:my-7 prose-hr:border-fg/10
                       prose-strong:text-fg prose-strong:font-semibold
                       prose-table:border-fg/10"
              >
                <slot />
              </div>
            </div>
          </div>
        </ReadFrostedGlass>
      </div>
    </div>

    {hasTableOfContents && (
      <aside
        id="article-toc-panel"
        class="article-toc-panel sticky top-28 flex max-h-[calc(100vh-8rem)] min-w-0 flex-col
               rounded-r-xl border-l border-fg/15 bg-bg/30 py-3.5 pr-3 pl-4
               backdrop-blur-md"
        aria-labelledby="article-toc-label"
      >
        <div class="mb-4 flex shrink-0 items-center justify-between gap-3">
          <p id="article-toc-label" class="text-sm font-semibold tracking-[0.12em] text-fg/70">
            文章目錄
          </p>
          <button
            type="button"
            data-toc-close
            class="toc-control -mr-1 flex size-11 items-center justify-center rounded-full hover:bg-fg/10 min-[56rem]:hidden"
            aria-label="關閉文章目錄"
          >
            <svg aria-hidden="true" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <path d="m6 6 12 12M6 18 18 6" />
            </svg>
          </button>
        </div>
        <div class="min-h-0 flex-1 overflow-y-auto overscroll-contain pr-1 no-scrollbar" data-toc-scroll>
          <TableOfContents
            headings={tocHeadings}
            labelledBy="article-toc-label"
            variant="sidebar"
          />
        </div>
      </aside>
    )}
  </div>

  {hasTableOfContents && (
    <button
      id="article-toc-toggle"
      type="button"
      class="toc-control article-toc-toggle fixed z-40 flex size-12 items-center justify-center rounded-full border border-fg/15 bg-bg/90 text-fg/85 shadow-lg backdrop-blur-md hover:text-accent min-[56rem]:hidden"
      aria-label="開啟文章目錄"
      aria-controls="article-toc-panel"
      aria-expanded="false"
    >
      <svg aria-hidden="true" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round">
        <path d="M9 6h11M9 12h11M9 18h11M4 6h.01M4 12h.01M4 18h.01" />
      </svg>
    </button>
  )}

  <style>
    .toc-control:focus-visible {
      outline: 2px solid var(--c-accent);
      outline-offset: 3px;
    }

    .article-toc-toggle {
      right: calc(1rem + env(safe-area-inset-right, 0px));
      bottom: calc(1rem + env(safe-area-inset-bottom, 0px));
    }

    /* Keep the floating panel outside the article's backdrop-filter container. */
    @media (width < 56rem) {
      .article-toc-panel {
        position: fixed;
        z-index: 40;
        top: auto;
        right: calc(1rem + env(safe-area-inset-right, 0px));
        bottom: calc(5rem + env(safe-area-inset-bottom, 0px));
        width: min(22rem, calc(100% - 2rem - env(safe-area-inset-left, 0px) - env(safe-area-inset-right, 0px)));
        max-height: min(65dvh, calc(100dvh - 10rem - env(safe-area-inset-bottom, 0px)));
        padding: 0.75rem 1rem;
        border: 1px solid color-mix(in oklab, var(--c-fg) 15%, transparent);
        border-radius: 1rem;
        background: color-mix(in oklab, var(--c-bg) 95%, transparent);
        box-shadow: 0 10px 30px rgb(0 0 0 / 0.15);
      }

      .article-toc-panel:not([data-open]) {
        display: none;
      }
    }
  </style>

  <style is:global>
    #article-content blockquote {
      font-style: normal;
    }

    #article-content blockquote p:first-of-type::before,
    #article-content blockquote p:last-of-type::after {
      content: none;
    }
  </style>

  <script>
  let articleTocCleanup: (() => void) | undefined;

  function readHash(): string {
    const hash = window.location.hash.slice(1);

    try {
      return decodeURIComponent(hash);
    } catch {
      return hash;
    }
  }

  function initializeArticleToc(): void {
    articleTocCleanup?.();
    articleTocCleanup = undefined;

    const article = document.getElementById('article-content');
    const tocLinks = Array.from(
      document.querySelectorAll<HTMLAnchorElement>('[data-toc-link][data-heading-id]'),
    );

    if (!article || tocLinks.length === 0) return;

    const linksByHeading = new Map<string, HTMLAnchorElement[]>();

    for (const link of tocLinks) {
      const headingId = link.dataset.headingId;
      if (!headingId) continue;

      const links = linksByHeading.get(headingId) ?? [];
      links.push(link);
      linksByHeading.set(headingId, links);
    }

    const articleHeadings = Array.from(
      article.querySelectorAll<HTMLElement>('h1[id], h2[id], h3[id]'),
    ).filter((heading) => linksByHeading.has(heading.id));

    if (articleHeadings.length === 0) return;

    const tocScroller = document.querySelector<HTMLElement>('[data-toc-scroll]');
    const tocPanel = document.getElementById('article-toc-panel');
    const tocToggle = document.getElementById('article-toc-toggle');
    const tocClose = tocPanel?.querySelector<HTMLButtonElement>('[data-toc-close]');
    // Keep this in sync with the layout and floating-panel breakpoint above.
    const sidebarMedia = window.matchMedia('(min-width: 56rem)');
    const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    let activeHeadingId = '';
    let activationY = 0;
    let activationBandHeight = 2;
    let documentEndActive = false;
    let updateFrame = 0;
    let resizeFrame = 0;
    let headingObserver: IntersectionObserver | undefined;

    function setMobileTocOpen(open: boolean, restoreFocus = true): void {
      if (!tocPanel || !tocToggle) return;

      const isOpen = open && !sidebarMedia.matches;
      tocPanel.toggleAttribute('data-open', isOpen);
      tocToggle.setAttribute('aria-expanded', String(isOpen));
      tocToggle.setAttribute('aria-label', isOpen ? '關閉文章目錄' : '開啟文章目錄');

      if (isOpen) {
        centerActiveTocLink(activeHeadingId, false);
        const currentLink = tocPanel.querySelector<HTMLAnchorElement>('[aria-current="location"]');
        (currentLink ?? tocClose)?.focus({ preventScroll: true });
      } else if (restoreFocus) {
        tocToggle.focus({ preventScroll: true });
      }
    }

    function handleTocToggle(): void {
      setMobileTocOpen(!tocPanel?.hasAttribute('data-open'));
    }

    function handleTocClose(): void {
      setMobileTocOpen(false);
    }

    function handleTocSelection(event: MouseEvent): void {
      if (sidebarMedia.matches || event.defaultPrevented || event.button !== 0 ||
          event.metaKey || event.ctrlKey || event.shiftKey || event.altKey) return;
      const link = event.target instanceof Element
        ? event.target.closest<HTMLAnchorElement>('[data-toc-link]')
        : null;
      if (!link) return;

      setMobileTocOpen(false, false);
      const heading = document.getElementById(link.dataset.headingId ?? '');
      if (heading) {
        // Preserve native anchor navigation while moving focus out of the hidden panel.
        if (!heading.hasAttribute('tabindex')) {
          heading.setAttribute('tabindex', '-1');
          heading.addEventListener('blur', () => heading.removeAttribute('tabindex'), { once: true });
        }
        heading.focus({ preventScroll: true });
      }
    }

    function handleTocEscape(event: KeyboardEvent): void {
      if (event.key === 'Escape' && tocPanel?.hasAttribute('data-open')) {
        event.preventDefault();
        setMobileTocOpen(false);
      }
    }

    function handleTocOutside(event: Event): void {
      if (!tocPanel?.hasAttribute('data-open') || !(event.target instanceof Node)) return;
      if (!tocPanel.contains(event.target) && !tocToggle?.contains(event.target)) {
        setMobileTocOpen(false, event.type === 'pointerdown' && tocPanel.contains(document.activeElement));
      }
    }

    function handleTocModeChange(): void {
      const focusWasInPanel = tocPanel?.contains(document.activeElement);
      const focusWasOnControl = document.activeElement === tocToggle || document.activeElement === tocClose;
      setMobileTocOpen(false, false);

      if (sidebarMedia.matches) {
        centerActiveTocLink(activeHeadingId, false);
        if (focusWasOnControl) {
          tocPanel?.querySelector<HTMLAnchorElement>('[aria-current="location"]')?.focus({ preventScroll: true });
        }
      } else if (focusWasInPanel) {
        tocToggle?.focus({ preventScroll: true });
      }
    }

    function centerActiveTocLink(headingId: string, animate: boolean): void {
      if (!tocScroller || tocScroller.clientHeight === 0) return;

      const activeLink = linksByHeading
        .get(headingId)
        ?.find((link) => tocScroller.contains(link));

      if (!activeLink) return;

      const scrollerRect = tocScroller.getBoundingClientRect();
      const linkRect = activeLink.getBoundingClientRect();
      const scrollportCenter =
        scrollerRect.top + tocScroller.clientTop + tocScroller.clientHeight / 2;
      const linkCenter = linkRect.top + linkRect.height / 2;
      const maximumScroll = Math.max(0, tocScroller.scrollHeight - tocScroller.clientHeight);
      const nextScroll = Math.min(
        maximumScroll,
        Math.max(0, tocScroller.scrollTop + linkCenter - scrollportCenter),
      );

      if (Math.abs(nextScroll - tocScroller.scrollTop) < 1) return;

      tocScroller.scrollTo({
        top: nextScroll,
        behavior: animate && !reduceMotion ? 'smooth' : 'auto',
      });
    }

    function setActiveHeading(headingId: string, animate = true): void {
      if (!linksByHeading.has(headingId) || headingId === activeHeadingId) return;

      activeHeadingId = headingId;

      for (const link of tocLinks) {
        if (link.dataset.headingId === headingId) {
          link.setAttribute('aria-current', 'location');
        } else {
          link.removeAttribute('aria-current');
        }
      }

      centerActiveTocLink(headingId, animate);
    }

    function updateActiveHeading(): void {
      let currentHeading = articleHeadings[0];

      for (const heading of articleHeadings) {
        if (heading.getBoundingClientRect().top <= activationY + activationBandHeight) {
          currentHeading = heading;
        } else {
          break;
        }
      }

      if (documentEndActive) {
        currentHeading = articleHeadings[articleHeadings.length - 1];
      }

      setActiveHeading(currentHeading.id, activeHeadingId !== '');
    }

    function queueActiveHeadingUpdate(): void {
      if (updateFrame) return;

      updateFrame = window.requestAnimationFrame(() => {
        updateFrame = 0;
        updateActiveHeading();
      });
    }

    function createObservers(): void {
      headingObserver?.disconnect();

      const rootFontSize = Number.parseFloat(
        window.getComputedStyle(document.documentElement).fontSize,
      ) || 16;
      activationBandHeight = 2;
      activationY = Math.min(
        rootFontSize * 7,
        Math.max(1, window.innerHeight - activationBandHeight),
      );
      const bottomMargin = Math.max(
        0,
        window.innerHeight - activationY - activationBandHeight,
      );

      headingObserver = new IntersectionObserver(queueActiveHeadingUpdate, {
        rootMargin: `-${activationY}px 0px -${bottomMargin}px 0px`,
        threshold: 0,
      });

      for (const heading of articleHeadings) {
        headingObserver.observe(heading);
      }

      queueActiveHeadingUpdate();
    }

    function isDocumentAtEnd(): boolean {
      const root = document.documentElement;
      const maximumScroll = root.scrollHeight - window.innerHeight;
      return maximumScroll > 2 && window.scrollY > 0 && window.scrollY >= maximumScroll - 16;
    }

    function handleDocumentScroll(): void {
      documentEndActive = isDocumentAtEnd();
      queueActiveHeadingUpdate();
    }

    function handleResize(): void {
      if (resizeFrame) return;

      resizeFrame = window.requestAnimationFrame(() => {
        resizeFrame = 0;
        documentEndActive = isDocumentAtEnd();
        createObservers();
        if (activeHeadingId) centerActiveTocLink(activeHeadingId, false);
      });
    }

    function handleHashChange(): void {
      const headingId = readHash();
      if (headingId) setActiveHeading(headingId, false);
      queueActiveHeadingUpdate();
    }

    const initialHeadingId = readHash();
    documentEndActive = isDocumentAtEnd();
    setActiveHeading(
      linksByHeading.has(initialHeadingId) ? initialHeadingId : articleHeadings[0].id,
      false,
    );

    window.addEventListener('hashchange', handleHashChange);
    tocToggle?.addEventListener('click', handleTocToggle);
    tocClose?.addEventListener('click', handleTocClose);
    tocPanel?.addEventListener('click', handleTocSelection);
    document.addEventListener('keydown', handleTocEscape);
    document.addEventListener('pointerdown', handleTocOutside);
    document.addEventListener('focusin', handleTocOutside);
    sidebarMedia.addEventListener('change', handleTocModeChange);

    if ('IntersectionObserver' in window) {
      createObservers();
      window.addEventListener('resize', handleResize, { passive: true });
      window.addEventListener('scroll', handleDocumentScroll, { passive: true });
    }

    articleTocCleanup = () => {
      headingObserver?.disconnect();
      window.removeEventListener('resize', handleResize);
      window.removeEventListener('scroll', handleDocumentScroll);
      window.removeEventListener('hashchange', handleHashChange);
      tocToggle?.removeEventListener('click', handleTocToggle);
      tocClose?.removeEventListener('click', handleTocClose);
      tocPanel?.removeEventListener('click', handleTocSelection);
      document.removeEventListener('keydown', handleTocEscape);
      document.removeEventListener('pointerdown', handleTocOutside);
      document.removeEventListener('focusin', handleTocOutside);
      sidebarMedia.removeEventListener('change', handleTocModeChange);
      if (updateFrame) window.cancelAnimationFrame(updateFrame);
      if (resizeFrame) window.cancelAnimationFrame(resizeFrame);
    };
  }

  document.addEventListener('astro:page-load', initializeArticleToc);
  document.addEventListener('astro:before-swap', () => articleTocCleanup?.());
  initializeArticleToc();
  </script>
</BaseLayout>
